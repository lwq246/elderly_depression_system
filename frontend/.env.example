# Optional — defaults to http://127.0.0.1:8000 (see next.config.mjs rewrites)
# BACKEND_URL=http://127.0.0.1:8000
# Browser fetch target. In development the app defaults to http://127.0.0.1:8000 so
# long analyst calls are not cut off by the Next.js 30s rewrite proxy (that looks like a 500).
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
