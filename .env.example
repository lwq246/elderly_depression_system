# LLM provider (required)
# OpenAI direct:
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   OPENAI_MODEL=gpt-4o-mini
# OpenRouter (GPT-4o mini):
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_MODEL=openai/gpt-4o-mini
# OpenRouter (Qwen3 14B via DeepInfra):
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_MODEL=qwen/qwen3-14b
#   OPENROUTER_PROVIDER=deepinfra
#   OPENROUTER_ALLOW_FALLBACKS=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-4o-mini

# Optional OpenRouter attribution (shown on openrouter.ai rankings)
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Elderly Depression Screening

# Leave OPENROUTER_PROVIDER empty for gpt-4o-mini default routing
# Set to deepinfra when using qwen/qwen3-14b
OPENROUTER_PROVIDER=
OPENROUTER_ALLOW_FALLBACKS=false

# RAG — policy ingest: python backend/rag/ingest.py --reset
# Enables analyst facility-policy RAG; companion culture vocab uses local glossary (no Chroma)
RAG_ENABLED=false
# Facility policy locales for analyst exit RAG
RAG_INDEX_LOCALES=en-AU
# Companion per-turn culture vocabulary (literal match from data.py)
RAG_VOCAB_LOCALES=en-SG,en-AU
RAG_VOCAB_TOP_K=20
# local = sentence-transformers on CPU; api = OpenRouter embeddings
RAG_EMBEDDING_BACKEND=local
RAG_LOCAL_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
RAG_EMBEDDING_MODEL=openai/text-embedding-3-small
# Min cosine similarity for Chroma hits (default 0.35; was RAG_MAX_DISTANCE=0.65)
RAG_MIN_SIMILARITY=0.35
RAG_TOP_K=3
# Summarize transcript with LLM before embedding RAG query (required when true; no raw fallback)
RAG_USE_LLM_SUMMARY=true
RAG_SUMMARY_MAX_CHARS=800

# SQLite database path (default: data/screening.db)
# DATABASE_PATH=

# Comma-separated frontend origins for CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Capture full LLM system/user prompts on session (test runner sends X-Capture-Llm-Inputs)
# CAPTURE_LLM_INPUTS=false
