# LLM provider (required)
# OpenAI direct:
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   OPENAI_MODEL=gpt-4o-mini
# OpenRouter (Qwen3 14B via DeepInfra):
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_MODEL=qwen/qwen3-14b
#   OPENROUTER_PROVIDER=deepinfra
#   OPENROUTER_ALLOW_FALLBACKS=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=qwen/qwen3-14b

# Optional OpenRouter attribution (shown on openrouter.ai rankings)
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Elderly Depression Screening

# Pin OpenRouter to a provider (deepinfra = lowest latency for Qwen on OpenRouter)
# Leave OPENROUTER_PROVIDER empty to use OpenRouter default routing
OPENROUTER_PROVIDER=deepinfra
OPENROUTER_ALLOW_FALLBACKS=false

# RAG (analyst only) — run ingest first: python backend/rag/ingest.py --reset
RAG_ENABLED=false
# Comma-separated policy locales to index (en-SG.md, en-AU.md). Omit SG to index AU only.
RAG_INDEX_LOCALES=en-AU
RAG_EMBEDDING_MODEL=openai/text-embedding-3-small
RAG_TOP_K=3
RAG_QUERY_MAX_CHARS=4000
# Summarize transcript with LLM before embedding RAG query (required when true; no raw fallback)
RAG_USE_LLM_SUMMARY=true
RAG_SUMMARY_MAX_CHARS=800

# SQLite database path (default: data/screening.db)
# DATABASE_PATH=

# Comma-separated frontend origins for CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
